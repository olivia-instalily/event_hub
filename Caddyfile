# EventHub — Cloud Run: Caddy routes for PostgREST + Node.js functions + SPA.
#
# Env vars (set on Cloud Run service via Secret Manager):
#   PORT                  - provided by Cloud Run (default 8080)
#   POSTGREST_ANON_JWT    - anon HS256 JWT for PostgREST (injected for browser requests)

{
	admin off
	auto_https off
}

# ── Public server (browser traffic) ───────────────────────────────────────────
:{$PORT:8080} {
	encode gzip

	# PostgREST REST API  →  strip /rest/v1 prefix, inject anon JWT
	handle /rest/* {
		uri strip_prefix /rest/v1
		reverse_proxy localhost:3000 {
			header_up Authorization "Bearer {$POSTGREST_ANON_JWT}"
			header_up apikey "{$POSTGREST_ANON_JWT}"
		}
	}

	# Node.js edge functions  →  strip /functions/v1 prefix
	handle /functions/* {
		uri strip_prefix /functions/v1
		reverse_proxy localhost:3001
	}

	# SPA static files with history-mode fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# ── Internal server (functions → PostgREST, service-role JWT passes through) ──
:9000 {
	handle /rest/* {
		uri strip_prefix /rest/v1
		reverse_proxy localhost:3000
	}
}
