# Copy to .env (gitignored) and fill in. Used by scripts/luma-sync.mjs only — server-side.
# Do NOT prefix with VITE_; that would expose secrets in the browser bundle.
LUMA_API_KEY=<your Luma host API key — requires a paid Luma tier>
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=<SERVICE_ROLE_KEY from `supabase status`>
